<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#F2BE2C">

        <TextView
            android:id="@+id/addMoneyBackButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="←  Add Money"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Go back"/>

        <TextView
            android:id="@+id/addMoneySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transfer money from your bank to your own e-Wallet"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>

    </LinearLayout>

    <!-- Main Form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Transaction Type -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transaction Type"
                android:textColor="#53657D"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#1769AA"
                android:layout_marginBottom="22dp"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🏦  Bank Account  →  Sonali e-Wallet"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Balance Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="#FAFBFD"
                android:elevation="2dp"
                android:layout_marginBottom="48dp">

                <TextView
                    android:id="@+id/balanceIcon"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:text="🏦"
                    android:textSize="25sp"/>

                <TextView
                    android:id="@+id/usableBalanceLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your Bank Balance"
                    android:textColor="#53657D"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/usableBalanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৳ Loading..."
                    android:textColor="#1769AA"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Amount -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Amount (৳)"
                android:textColor="#53657D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/addAmountInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Enter Amount"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:padding="14dp"
                android:textSize="16sp"
                android:backgroundTint="#D9DDE3"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="46dp"/>

            <!-- PIN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PIN"
                android:textColor="#53657D"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/addMoneyPinInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Enter e-Wallet PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:singleLine="true"
                android:padding="14dp"
                android:textSize="16sp"
                android:backgroundTint="#D9DDE3"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Submit Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/addMoneySubmitButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="SUBMIT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="17sp"
            android:backgroundTint="#1769AA"/>

    </LinearLayout>

</LinearLayout>
