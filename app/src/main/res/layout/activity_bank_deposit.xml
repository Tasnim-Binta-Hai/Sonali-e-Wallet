<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="155dp"
        android:orientation="vertical"
        android:gravity="bottom"
        android:padding="18dp"
        android:background="#F2BE2C">

        <TextView
            android:id="@+id/bankDepositBackButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="←  Bank Deposit"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Go back"/>

    </LinearLayout>

    <!-- MAIN FORM -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="44dp">

            <!-- WALLET BALANCE CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="#FAFBFD"
                android:elevation="2dp"
                android:layout_marginBottom="48dp">

                <TextView
                    android:id="@+id/depositBalanceIcon"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="👛"
                    android:textSize="27sp"/>

                <TextView
                    android:id="@+id/depositUsableBalanceLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wallet Balance"
                    android:textColor="#53657D"
                    android:textSize="18sp"/>

                <TextView
                    android:id="@+id/depositUsableBalanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৳ Loading..."
                    android:textColor="#1769AA"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- AMOUNT LABEL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deposit Amount (৳)"
                android:textColor="#53657D"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <!-- AMOUNT INPUT -->
            <EditText
                android:id="@+id/depositAmountInput"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:hint="Enter Amount"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:padding="18dp"
                android:textSize="17sp"
                android:textColor="#17365D"
                android:textColorHint="#B5B8BC"
                android:background="@drawable/deposit_input_background"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="48dp"/>

            <!-- PIN LABEL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PIN"
                android:textColor="#53657D"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <!-- PIN INPUT -->
            <EditText
                android:id="@+id/depositPinInput"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:hint="Enter e-Wallet PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:singleLine="true"
                android:padding="18dp"
                android:textSize="17sp"
                android:textColor="#17365D"
                android:textColorHint="#B5B8BC"
                android:background="@drawable/deposit_input_background"
                android:layout_marginTop="22dp"/>

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM SUBMIT BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="32dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/bankDepositSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:text="SUBMIT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="19sp"
            android:backgroundTint="#1763A5"/>

    </LinearLayout>

</LinearLayout>
